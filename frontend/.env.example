# URL publique du backend. Garder /api dans la valeur pour que api.js reste unique.
VITE_API_BASE_URL=http://localhost:8000/api

# URL publique du frontend.
VITE_APP_URL=http://localhost:5173

# Route ouverte après une authentification réussie.
VITE_AUTH_AFTER_LOGIN=/app

# Timeout Axios en millisecondes.
VITE_API_TIMEOUT_MS=15000
