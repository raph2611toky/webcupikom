MODE_DEV=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False

# Branding
SITE_NAME=Administration
SUPPORT_EMAIL=support@example.com

# Google Identity / OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit correspondre EXACTEMENT à un Authorized redirect URI dans Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Durée de validité du state OAuth signé, en secondes.
GOOGLE_OAUTH_STATE_MAX_AGE=600

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Email. En dev, laissez EMAIL_BACKEND sur console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# MySQL optionnel. Si DB_NAME est vide/absent, SQLite est utilisé.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Documentation API (Swagger / ReDoc)
# Utilisez un mot de passe long et différent des comptes administrateurs.
SWAGGER_PASSWORD=change-me-with-a-long-random-password
