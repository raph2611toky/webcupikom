# -----------------------------------------------------------------------------
# Environnement
# -----------------------------------------------------------------------------
MODE_DEV=True
SECRET_KEY=change-me-django-secret
ALLOWED_HOSTS=127.0.0.1,localhost

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False

# -----------------------------------------------------------------------------
# Authentification / JWT
# JWT_SIGNING_KEY doit rester uniquement sur le backend.
# Génération recommandée : python -c "import secrets; print(secrets.token_urlsafe(64))"
# -----------------------------------------------------------------------------
JWT_SIGNING_KEY=change-me-with-a-long-random-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Refresh token : cookie HttpOnly, donc inaccessible au JavaScript du navigateur.
AUTH_REFRESH_COOKIE_NAME=kamo_refresh
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_PATH=/api/auth/
AUTH_REFRESH_COOKIE_MAX_AGE=2592000
AUTH_COOKIE_REMEMBER_DEFAULT=True

# Cookies Django (Swagger/session + CSRF). En production HTTPS : True.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# Branding
# -----------------------------------------------------------------------------
SITE_NAME=Administration
SUPPORT_EMAIL=support@example.com

# -----------------------------------------------------------------------------
# Google OAuth 2.0
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_OAUTH_STATE_MAX_AGE=600

# -----------------------------------------------------------------------------
# Mot de passe / email
# -----------------------------------------------------------------------------
PASSWORD_RESET_TIMEOUT=3600
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# -----------------------------------------------------------------------------
# MySQL optionnel. Si DB_NAME est vide/absent, SQLite est utilisé.
# -----------------------------------------------------------------------------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Swagger protégé
SWAGGER_PASSWORD=

# -----------------------------------------------------------------------------
# WebCup / Terra Nova
# La clé officielle reste uniquement ici, jamais dans VITE_* côté frontend.
# -----------------------------------------------------------------------------
WEBCUP_REQUESTS_URL=https://24h.webcup.fr/wp-json/webcup/v1/requests
WEBCUP_API_KEY=
WEBCUP_REQUEST_TIMEOUT=8
WEBCUP_CACHE_SECONDS=15

# -----------------------------------------------------------------------------
# Sécurité / reverse proxy / limitation de débit
# -----------------------------------------------------------------------------
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=False
THROTTLE_AUTH=20/min
THROTTLE_AUTH_EMAIL=5/min
THROTTLE_PASSWORD_RESET=5/min
THROTTLE_CONTACT=10/min
THROTTLE_WEBCUP=60/min
