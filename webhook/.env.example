# Android central (serveur HTTP local de l'application SMS)
ANDROID_SMS_BASE_URL=http://192.168.8.8:8000
GATEWAY_WEBHOOK_TOKEN=CHANGE_ME_SHARED_ANDROID_GATEWAY_TOKEN
ANDROID_WEBHOOK_TOKEN=CHANGE_ME_ANDROID_TOKEN

# Gemini. Depuis septembre 2026, utilisez une clé d'autorisation Gemini valide.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Backend Nova Terra, supposé frère du dossier webhook/gateway.
NOVA_TERRA_BACKEND_PATH=../backend
NOVA_TERRA_DJANGO_SETTINGS=config.settings
# Force l'utilisation du backend/db.sqlite3 même si backend/.env contient une config MySQL.
NOVA_TERRA_FORCE_SQLITE=true

# Etat conversationnel du gateway (séparé des données métier Nova Terra)
SMS_AI_DB_PATH=./sms_gateway_state.sqlite3
SMS_AI_SESSION_TTL_HOURS=24
SMS_AI_MAX_REPLY_CHARS=700

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_MAX_BODY_BYTES=65536
GATEWAY_CONNECT_TIMEOUT_SECONDS=4
GATEWAY_READ_TIMEOUT_SECONDS=15
GATEWAY_ENABLE_UPSTREAM_HEALTH=true
LOG_LEVEL=INFO
